# Neon Postgres — get this from your Neon project dashboard (use the "pooled connection" string)
NEON_DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# LINE Messaging API — get these from the LINE Developers Console for your channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# NewebPay — get these from your NewebPay merchant backend
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
